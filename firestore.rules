rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'rafaelhirofujii17@gmail.com';
    }

    function isValidOrder(data) {
      return data.customerName is string && data.customerName.size() <= 100 &&
             data.date is string &&
             data.time is string &&
             data.total is number &&
             data.items is list &&
             (data.createdAt == request.time || (resource != null && data.createdAt == resource.data.createdAt));
    }

    match /test_settings/{doc} {
      allow read, write: if true;
    }

    match /test_settings_2/{doc} {
      allow read, write: if true;
    }

    // Settings: Public read, Admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      // Anyone can submit an order
      allow create: if isValidOrder(request.resource.data);
      
      // Anyone with the ID can track their order, but only admin can LIST all orders
      allow get: if true;
      allow list: if isAdmin() || resource.data.testUserId != null;
      
      // Admins can update status, mark as deleted, etc.
      allow update: if isAdmin();
      
      // Admins can permanently delete
      allow delete: if isAdmin();
    }

    match /inventory/{productName} {
      // Public needs to read product costs/stock for catalog logic if applicable
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      // Anyone can see reviews
      allow read: if true;
      allow list: if isAdmin() || (resource != null && resource.data.status == 'approved');
      
      // Signed in users can create a pending review
      allow create: if isSignedIn() && 
                    request.resource.data.status == 'pending' &&
                    request.resource.data.rating >= 1 &&
                    request.resource.data.rating <= 5 &&
                    request.resource.data.createdAt == request.time;
      
      // Only admin can update (moderation) or delete
      allow update, delete: if isAdmin();
    }

    match /ingredients/{ingredientId} {
      allow read, write: if isAdmin();
    }

    match /recipes/{productName} {
      allow read, write: if isAdmin();
    }

    match /ready_boxes/{boxId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /customer_notes/{customerKey} {
      allow read, write: if isAdmin();
    }
  }
}

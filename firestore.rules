rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'rafaelhirofujii17@gmail.com' ||
        request.auth.token.email == 'rafaelhirofujii17@gmail.com'
      );
    }

    function isValidOrder(data) {
      return data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 120 &&
             data.date is string &&
             data.time is string &&
             data.total is number &&
             data.items is list;
    }

    match /test_settings/{doc} {
      allow read, write: if true;
    }

    match /test_settings_2/{doc} {
      allow read, write: if true;
    }

    // Settings: Public read, Admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      // Anyone can submit an order
      allow create: if isValidOrder(request.resource.data);
      
      // Anyone with the ID can track their order, but only admin can LIST all orders
      allow get: if true;
      allow list: if isAdmin() || resource.data.testUserId != null;
      
      // Admins can update status, mark as deleted, etc. Customers can rate their delivered order.
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewComment', 'reviewedAt']) &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5
      );
      
      // Admins can permanently delete
      allow delete: if isAdmin();
    }

    match /inventory/{productName} {
      // Public needs to read product costs/stock for catalog logic if applicable
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      // Anyone can see reviews
      allow read: if true;
      allow list: if isAdmin() || (resource != null && resource.data.status == 'approved');
      
      // Customers can create a pending review
      allow create: if request.resource.data.status == 'pending' && 
                    request.resource.data.rating >= 1 &&
                    request.resource.data.rating <= 5 &&
                    (request.resource.data.createdAt == request.time || request.resource.data.createdAt != null);
      
      // Only admin can update (moderation) or delete
      allow update, delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
      // Allow atomic usage count increment if needed
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount', 'updatedAt']));
    }

    match /ingredients/{ingredientId} {
      allow read, write: if isAdmin();
    }

    match /recipes/{productName} {
      allow read, write: if isAdmin();
    }

    match /ready_boxes/{boxId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantityAvailable', 'updatedAt']));
    }

    match /customer_notes/{customerKey} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /verified_phones/{phone} {
      // Anyone can check if a phone is verified, or create/update verification record
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    match /phone_verifications/{phone} {
      // Allow reading and writing temporary verification codes
      allow read, write: if true;
    }
  }
}

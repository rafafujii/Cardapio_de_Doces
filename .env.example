# --- CONFIGURAÇÃO AUTOMÁTICA ---
# O aplicativo agora usa o arquivo 'firebase-applet-config.json' automaticamente.
# Você NÃO precisa configurar variáveis de ambiente no Vercel para o funcionamento básico.

# Caso queira usar um projeto diferente do Firebase no Vercel (opcional):
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_FIRESTORE_DATABASE_ID=

{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "Represents a sweet order submitted by a customer",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "items": { 
          "type": "array",
          "items": { "type": "object" }
        },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed", "cancelled", "deleted"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "deletedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      },
      "required": ["customerName", "date", "time", "items", "total", "createdAt"]
    },
    "Inventory": {
      "title": "Inventory",
      "description": "Product cost and stock tracking",
      "type": "object",
      "properties": {
        "productName": { "type": "string" },
        "costPerUnit": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productName", "costPerUnit"]
    },
    "Review": {
      "title": "Review",
      "description": "Product reviews and ratings",
      "type": "object",
      "properties": {
        "productName": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productName", "userName", "rating", "status", "createdAt"]
    },
    "Ingredient": {
      "title": "Ingredient",
      "description": "Base ingredient for recipes",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "unit": { "type": "string" },
        "costPerUnit": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "unit", "costPerUnit"]
    },
    "Recipe": {
      "title": "Recipe",
      "description": "Link between product and its ingredients",
      "type": "object",
      "properties": {
        "productName": { "type": "string" },
        "ingredients": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ingredientId": { "type": "string" },
              "quantity": { "type": "number" }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productName", "ingredients"]
    },
    "ReadyBox": {
      "title": "Ready Box",
      "description": "Daily sweet boxes for quick immediate order",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "itemsCount": { "type": "number" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "quantityAvailable": { "type": "number" },
        "imageUrl": { "type": "string" },
        "pickupUntilTime": { "type": "string" },
        "badgeText": { "type": "string" },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "price", "quantityAvailable", "active"]
    },
    "CustomerNote": {
      "title": "Customer Note",
      "description": "Confectioner CRM notes, VIP preferences, tags and birthday",
      "type": "object",
      "properties": {
        "customerPhone": { "type": "string" },
        "customerName": { "type": "string" },
        "birthday": { "type": "string" },
        "notes": { "type": "string" },
        "tags": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discount coupons for marketing and customer loyalty",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "description": { "type": "string" },
        "discountType": { "type": "string", "enum": ["percent", "fixed"] },
        "discountValue": { "type": "number" },
        "minOrderValue": { "type": "number" },
        "maxDiscountAmount": { "type": "number" },
        "usageLimit": { "type": "number" },
        "usageCount": { "type": "number" },
        "expirationDate": { "type": "string" },
        "active": { "type": "boolean" },
        "showBanner": { "type": "boolean" },
        "bannerText": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "discountType", "discountValue", "active"]
    },
    "GlobalSettings": {
      "title": "Global Settings",
      "description": "General site-wide configuration",
      "type": "object",
      "properties": {
        "contactPhone": { "type": "string" },
        "googleSheetId": { "type": "string" },
        "pixKey": { "type": "string" },
        "pickupAddress": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "Administrative audit trail logs for changes in global settings",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "summary": { "type": "string" },
        "changedFields": { "type": "array" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["action", "userEmail", "timestamp"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of all customer orders"
    },
    "/inventory/{productName}": {
      "schema": "Inventory",
      "description": "Cost tracking per product type"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Product reviews from customers"
    },
    "/ingredients/{ingredientId}": {
      "schema": "Ingredient",
      "description": "Global ingredients list and costs"
    },
    "/recipes/{productName}": {
      "schema": "Recipe",
      "description": "Product recipe definitions"
    },
    "/ready_boxes/{boxId}": {
      "schema": "ReadyBox",
      "description": "Daily ready-to-deliver sweet boxes for immediate pickup"
    },
    "/customer_notes/{customerKey}": {
      "schema": "CustomerNote",
      "description": "Confectioner CRM notes and customer preferences"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Promotional discount coupons"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Administrative audit trail logs for changes in global settings"
    },
    "/settings/global": {
      "schema": "GlobalSettings",
      "description": "Global configuration document"
    }
  }
}
